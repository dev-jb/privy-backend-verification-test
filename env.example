# Privy Configuration
# Get these values from your Privy Dashboard: https://dashboard.privy.io/

# Your Privy App ID
PRIVY_APP_ID=your-privy-app-id

# Your Privy App Secret
PRIVY_APP_SECRET=your-privy-app-secret

# JWT Verification Key
# Get this from Configuration > App settings in your Privy Dashboard
PRIVY_JWT_VERIFICATION_KEY=your-verification-key-from-dashboard

# Server Configuration
PORT=3001

# Frontend URL for CORS (optional)
FRONTEND_URL=http://localhost:3000
